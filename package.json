{
  "name": "flash-sale engine",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "start:expiresWorker": "cross-env NODE_ENV=production node dist/workers/expiresWorker.js",
    "start:fulfillOrderWorker": "cross-env NODE_ENV=production node dist/workers/fulfillOrderWorker.js",
    "start:cleanupWorker": "cross-env NODE_ENV=production node dist/workers/cleanupWorker.js",
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "dev:expiresWorker": "cross-env NODE_ENV=development tsx watch src/workers/expiresWorker.ts",
    "dev:fulfillOrderWorker": "cross-env NODE_ENV=development tsx watch src/workers/fulfillOrderWorker.ts",
    "dev:cleanupWorker": "cross-env NODE_ENV=development tsx watch src/workers/cleanupWorker.ts",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:unit": "cross-env NODE_ENV=test vitest run tests/unit",
    "test:integration": "cross-env NODE_ENV=test vitest run tests/integration",
    "test:e2e": "cross-env NODE_ENV=test vitest run tests/e2e",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:watch": "cross-env NODE_ENV=test vitest"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bullmq": "^5.56.10",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "rate-limit-redis": "^5.0.0",
    "socket.io": "^4.8.1",
    "stripe": "^18.5.0",
    "uuid": "^14.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "cross-env": "^10.0.0",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  }
}
